---
export const prerender = false;

import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { Icon } from 'astro-icon/components'
---

<Layout variant="immersive">
  <PageHead
    slot="head"
    title="Category Manager"
    description="Organize security notes into categories for the public archive and editor."
  />

  <div x-data="categoryEditor" class="min-h-screen">
    <!-- Header / Command Bar -->
    <section class="border-b border-white/10 bg-black/40">
      <div class="mx-auto max-w-[1400px] px-4 py-10 sm:px-6 lg:px-8">
        <Breadcrumbs
          variant="immersive"
          items={[
            { label: 'Admin', href: '/admin', icon: 'lucide:shield' },
            { label: 'Categories', icon: 'lucide:folder-tree' },
          ]}
        />

        <div class="mt-8 flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <p class="font-mono text-[0.68rem] tracking-[0.28em] text-white/40 uppercase">
              Operator Console // Taxonomy
            </p>
            <h1 class="mt-3 text-3xl font-medium tracking-tight text-white sm:text-4xl">
              Category Manager
            </h1>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="/admin"
              class="inline-flex items-center gap-2 border border-white/10 bg-white/[0.04] px-4 py-2 font-mono text-xs tracking-widest text-white/80 uppercase hover:border-white/30 hover:text-white cursor-pointer transition-colors"
            >
              ← Back to Dashboard
            </a>
            <button
              type="button"
              @click="startCreate()"
              x-show="editingId"
              class="border border-white/20 bg-white/[0.06] px-4 py-2 font-mono text-xs tracking-widest text-white uppercase hover:bg-white/[0.12] cursor-pointer transition-colors"
            >
              + New Category
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Workspace -->
    <section class="mx-auto max-w-[1400px] px-4 py-10 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[1fr_22rem]">

        <!-- Category List -->
        <div>
          <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <span class="font-mono text-[0.66rem] tracking-[0.24em] text-white/40 uppercase">
              Registry // <span x-text="categories.length"></span> entries
            </span>
          </div>

          <div class="divide-y divide-white/10" x-show="!isLoading">
            <template x-for="category in categories" :key="category.id">
              <div class="group flex flex-col justify-between gap-4 py-6 sm:flex-row sm:items-center">
                <div class="space-y-2">
                  <div class="flex items-center gap-3">
                    <span class="font-mono text-[0.66rem] text-white/30 uppercase tracking-wider" x-text="'#' + category.id"></span>
                    <h2 class="text-lg font-medium tracking-tight text-white" x-text="category.name"></h2>
                    <span class="font-mono text-xs text-white/30" x-text="`/${category.slug}`"></span>
                  </div>
                  <p class="max-w-2xl text-sm text-white/50"
                     x-text="category.description || 'No description provided.'"></p>
                </div>

                <div class="flex items-center gap-4 self-start font-mono text-xs sm:self-center">
                  <span class="text-white/40" x-text="(category.postCount ?? 0) + ' notes'"></span>
                  <button
                    type="button"
                    @click="startEdit(category)"
                    class="border border-white/10 bg-white/[0.04] px-3 py-1.5 text-white/80 hover:border-white/30 hover:text-white transition-colors cursor-pointer"
                  >
                    Edit
                  </button>
                  <button
                    type="button"
                    @click="remove(category.id)"
                    class="text-red-400/60 hover:text-red-400 transition-colors cursor-pointer"
                  >
                    Delete
                  </button>
                </div>
              </div>
            </template>

            <!-- Empty State -->
            <div
              x-show="!isLoading && categories.length === 0"
              class="py-16 text-center font-mono text-xs tracking-widest text-white/30 uppercase"
            >
              No categories defined yet
            </div>

            <!-- Loading State -->
            <div x-show="isLoading" class="py-16 text-center font-mono text-xs tracking-widest text-white/30 uppercase">
              Querying registry...
            </div>
          </div>
        </div>

        <!-- Create / Edit Panel -->
        <aside class="space-y-6">
          <div class="border border-white/10 bg-white/[0.02] p-6 space-y-4 sticky top-24">
            <p class="font-mono text-[0.66rem] tracking-[0.24em] text-white/40 uppercase"
               x-text="editingId ? 'Editing #' + editingId : 'New Entry'"></p>

            <div>
              <label class="block font-mono text-xs text-white/50 uppercase mb-2">Name</label>
              <input
                type="text"
                x-model="form.name"
                placeholder="e.g. Binary Exploitation"
                class="w-full border border-white/10 bg-black/60 px-3 py-2 text-sm text-white placeholder:text-white/20 focus:border-white/40 focus:outline-none"
              />
              <p class="mt-1.5 font-mono text-[0.62rem] text-white/30">
                Slug auto-generated: <span class="text-white/50" x-text="'/' + slugify(form.name)"></span>
              </p>
            </div>

            <div>
              <label class="block font-mono text-xs text-white/50 uppercase mb-2">Description</label>
              <textarea
                x-model="form.description"
                rows="3"
                placeholder="Optional context shown on category pages..."
                class="w-full border border-white/10 bg-black/60 px-3 py-2 text-sm text-white/80 placeholder:text-white/20 focus:border-white/40 focus:outline-none"
              ></textarea>
            </div>

            <p x-show="error" class="font-mono text-xs text-red-400" x-text="error"></p>

            <button
              type="button"
              @click="save()"
              :disabled="isSaving"
              class="w-full border border-white/20 bg-white py-2.5 font-mono text-xs tracking-widest font-semibold text-black uppercase hover:bg-white/90 cursor-pointer disabled:opacity-50 transition-all"
            >
              <span x-text="isSaving ? 'Synchronizing...' : (editingId ? 'Update Category' : 'Create Category')"></span>
            </button>

            <button
              type="button"
              x-show="editingId"
              @click="startCreate()"
              class="w-full font-mono text-xs text-white/40 hover:text-white transition-colors cursor-pointer"
            >
              Cancel edit
            </button>
          </div>
        </aside>
      </div>
    </section>
  </div>
</Layout>

<script src="@/scripts/admin/category-editor.ts"></script>
<script src="@/scripts/admin/page-guard.ts"></script>
