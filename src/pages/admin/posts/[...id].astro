---
export const prerender = false;

import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { Icon } from 'astro-icon/components'
import SegmentedControl from '@/components/ui/segmented-control.astro'
const { id } = Astro.params
const isEditMode = Boolean(id && id !== 'new')
const pageTitle = isEditMode ? 'Edit Post' : 'Compose Post'

---

<Layout variant="immersive">
  <PageHead slot="head" title={pageTitle} />

  <!-- Alpine Component Root -->
  <div
    x-data={`postEditor({ isEditMode: ${isEditMode}, postId: '${id || ""}' })`}
    x-init="init()"
    class="min-h-screen"
  >
    <!-- Header / Command Bar -->
    <section class="border-b border-white/10 bg-black/40">
      <div class="mx-auto max-w-[1400px] px-4 py-10 sm:px-6 lg:px-8">
        <Breadcrumbs
          variant="immersive"
          items={[
            { label: 'Admin', href: '/admin', icon: 'lucide:shield' },
            { label: 'Notes', href: '/admin/posts', icon: 'lucide:library-big' },
            { label: pageTitle, icon: isEditMode ? 'lucide:file-edit' : 'lucide:file-plus-2' },
          ]}
        />

        <div class="mt-8 flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <p class="font-mono text-[0.68rem] tracking-[0.28em] text-white/40 uppercase">
              Operator Console // <span x-text="isEditMode ? 'Revising' : 'Staging'"></span>
            </p>
            <h1 class="mt-3 text-3xl font-medium tracking-tight text-white sm:text-4xl">
              {pageTitle}
            </h1>
          </div>

          <button
            type="button"
            @click="savePost()"
            :disabled="isSaving"
            class="inline-flex items-center gap-2 border border-white/20 bg-white px-5 py-2 font-mono text-xs tracking-widest font-semibold text-black uppercase hover:bg-white/90 cursor-pointer disabled:opacity-50"
          >
            <span x-text="isSaving ? 'Synchronizing...' : 'Save Note'"></span>
          </button>
        </div>
      </div>
    </section>

    <!-- Main Workspace -->
    <section class="mx-auto max-w-[1400px] px-4 py-10 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[1fr_22rem]">
        
        <!-- Left: Form + Dynamic Blocks -->
        <div class="space-y-8">
          <div class="border border-white/10 bg-white/[0.02] p-6 space-y-4">
            <div>
              <label class="block font-mono text-xs text-white/50 uppercase mb-2">Title</label>
              <input
                type="text"
                x-model="form.title"
                placeholder="Article title..."
                class="w-full border border-white/10 bg-black/60 px-4 py-2.5 text-white focus:border-white/40 focus:outline-none"
              />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="block font-mono text-xs text-white/50 uppercase mb-2">Slug</label>
                <input
                  type="text"
                  x-model="form.slug"
                  placeholder="post-slug"
                  class="w-full border border-white/10 bg-black/60 px-4 py-2 text-white font-mono text-sm focus:border-white/40 focus:outline-none"
                />
              </div>
              <div>
                <SegmentedControl
                  label="Classification"
                  model="form.contentType"
                  options={[
                    { value: 'article', label: 'Article' },
                    { value: 'writeup', label: 'Write-Up' },
                    { value: 'cheatsheet', label: 'Cheat' },
                  ]}
                />
              </div>
            </div>
          </div>

          <!-- Blocks List -->
          <div class="space-y-4">
            <div class="flex items-center justify-between border-b border-white/10 pb-4">
              <span class="font-mono text-xs text-white/40 uppercase">Content Blocks</span>
              <div class="flex gap-2">
                <button
                  type="button"
                  @click="showImport = !showImport"
                  class="border border-white/10 bg-white/[0.04] px-3 py-1 font-mono text-xs text-white/70 hover:text-white cursor-pointer"
                >⇩ Import JSON</button>
                <button
                  type="button"
                  @click="addBlock('markdown')"
                  class="border border-white/10 bg-white/[0.04] px-3 py-1 font-mono text-xs text-white/70 hover:text-white"
                >+ Markdown</button>
                <button
                  type="button"
                  @click="addBlock('code_snippet')"
                  class="border border-white/10 bg-white/[0.04] px-3 py-1 font-mono text-xs text-white/70 hover:text-white"
                >+ Code</button>
                <button
                  type="button"
                  @click="addBlock('image')"
                  class="border border-white/10 bg-white/[0.04] px-3 py-1 font-mono text-xs text-white/70 hover:text-white"
                >+ Image</button>
              </div>
            </div>

            <!-- Agent JSON Import Panel -->
            <div x-show="showImport" class="border border-white/10 bg-white/[0.02] p-4 space-y-3">
              <p class="font-mono text-[0.66rem] tracking-[0.24em] text-white/40 uppercase">
                Paste agent output // docs/agent/post-content-guide.md contract
              </p>
              <textarea
                x-model="importJson"
                rows="8"
                placeholder='{"title": "...", "slug": "...", "blocks": [{ "blockType": "markdown", "orderIndex": 0, "payload": { "content": "..." } }]}'
                class="w-full border border-white/10 bg-black/90 p-3 font-mono text-xs text-emerald-400 placeholder:text-white/20 focus:border-white/40 focus:outline-none"
              ></textarea>
              <p x-show="importError" x-text="importError" class="font-mono text-xs text-red-400"></p>
              <button
                type="button"
                @click="importFromJson(importJson)"
                class="border border-white/20 bg-white px-4 py-1.5 font-mono text-xs font-semibold text-black uppercase hover:bg-white/90 cursor-pointer"
              >Load into editor</button>
            </div>

            <!-- Loop through blocks reactively -->
            <template x-for="(block, index) in form.blocks" :key="index">
              <div class="border border-white/10 bg-white/[0.02] p-5 space-y-3">
                <div class="flex justify-between items-center border-b border-white/10 pb-2">
                  <span class="font-mono text-xs text-white/40" x-text="'#' + (index + 1) + ' // ' + block.blockType"></span>
                  <button
                    type="button"
                    @click="removeBlock(index)"
                    class="font-mono text-xs text-red-400 hover:text-red-300"
                  >[Remove]</button>
                </div>

                <!-- Markdown Block -->
                <template x-if="block.blockType === 'markdown'">
                  <textarea
                    rows="4"
                    x-model="block.payload.content"
                    placeholder="Markdown content..."
                    class="w-full border border-white/10 bg-black/60 p-3 font-mono text-sm text-white focus:outline-none"
                  ></textarea>
                </template>

                <!-- Code Snippet Block -->
                <template x-if="block.blockType === 'code_snippet'">
                  <div class="space-y-2">
                    <input
                      type="text"
                      x-model="block.payload.language"
                      placeholder="Language (e.g. python)"
                      class="border border-white/10 bg-black/60 px-3 py-1 font-mono text-xs text-white"
                    />
                    <textarea
                      rows="5"
                      x-model="block.payload.code"
                      placeholder="Code..."
                      class="w-full border border-white/10 bg-black/90 p-3 font-mono text-xs text-emerald-400 focus:outline-none"
                    ></textarea>
                  </div>
                </template>

                <!-- Image Block -->
                <template x-if="block.blockType === 'image'">
                  <input
                    type="text"
                    x-model="block.payload.url"
                    placeholder="Google Drive Public URL"
                    class="w-full border border-white/10 bg-black/60 px-3 py-2 font-mono text-xs text-white"
                  />
                </template>
              </div>
            </template>
          </div>
        </div>

        <!-- Right: Status -->
        <aside class="space-y-6">
          <div class="border border-white/10 bg-white/[0.02] p-6 space-y-4 sticky top-24">
                <SegmentedControl
                  label="Classification"
                  model="form.contentType"
                  options={[
                    { value: 'article', label: 'Article' },
                    { value: 'writeup', label: 'Write-Up' },
                    { value: 'cheatsheet', label: 'Cheat' },
                  ]}
                />
          </div>
        </aside>
      </div>
    </section>
  </div>
</Layout>

<script src="@/scripts/admin/post-editor.ts"></script>