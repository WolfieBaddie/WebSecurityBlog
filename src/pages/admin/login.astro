---
export const prerender = false;

import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
---

<Layout variant="immersive">
  <PageHead
    slot="head"
    title="Operator Sign-In"
    description="Authenticate to access the operator console."
  />

  <div
    x-data={`loginForm({ next: '${Astro.url.searchParams.get("next") || "/admin"}' })`}
    class="flex min-h-screen items-center justify-center px-4"
  >
    <div class="w-full max-w-md space-y-8">
      <div class="text-center">
        <p class="font-mono text-[0.68rem] tracking-[0.28em] text-white/40 uppercase">
          Operator Console // Restricted Zone
        </p>
        <h1 class="mt-3 text-3xl font-medium tracking-tight text-white">
          Sign In
        </h1>
        <p class="mt-2 font-mono text-xs text-white/40">
          Credentials are verified against core.users
        </p>
      </div>

      <form @submit.prevent="submit()" class="border border-white/10 bg-white/[0.02] p-6 space-y-5">
        <div>
          <label class="block font-mono text-xs text-white/50 uppercase mb-2">Username / Email</label>
          <input
            type="text"
            x-model="identifier"
            autocomplete="username"
            placeholder="operator"
            class="w-full border border-white/10 bg-black/60 px-4 py-2.5 font-mono text-sm text-white placeholder:text-white/20 focus:border-white/40 focus:outline-none"
          />
        </div>

        <div>
          <label class="block font-mono text-xs text-white/50 uppercase mb-2">Password</label>
          <input
            type="password"
            x-model="password"
            autocomplete="current-password"
            placeholder="••••••••"
            class="w-full border border-white/10 bg-black/60 px-4 py-2.5 font-mono text-sm text-white placeholder:text-white/20 focus:border-white/40 focus:outline-none"
          />
        </div>

        <p x-show="error" x-text="error" class="font-mono text-xs text-red-400"></p>

        <button
          type="submit"
          :disabled="isSubmitting"
          class="w-full border border-white/20 bg-white py-2.5 font-mono text-xs tracking-widest font-semibold text-black uppercase hover:bg-white/90 cursor-pointer disabled:opacity-50 transition-all"
        >
          <span x-text="isSubmitting ? 'Authenticating...' : 'Authenticate'"></span>
        </button>
      </form>

      <p class="text-center font-mono text-[0.62rem] tracking-widest text-white/25 uppercase">
        Unauthorized access attempts are logged
      </p>
    </div>
  </div>
</Layout>

<script src="@/scripts/admin/login-form.ts"></script>
