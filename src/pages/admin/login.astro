---
export const prerender = false;

import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'

const next = Astro.url.searchParams.get('next') || '/admin'
const safeNext = next.startsWith('/admin') ? next : '/admin'
const error = Astro.url.searchParams.get('error') || ''
---

<Layout variant="immersive">
  <PageHead
    slot="head"
    title="Operator Sign-In"
    description="Authenticate to access the operator console."
  />

  <div class="flex min-h-screen items-center justify-center px-4">
    <div class="w-full max-w-md space-y-8">
      <div class="text-center">
        <p class="font-mono text-[0.68rem] tracking-[0.28em] text-white/40 uppercase">
          Operator Console // Restricted Zone
        </p>
        <h1 class="mt-3 text-3xl font-medium tracking-tight text-white">
          Sign In
        </h1>
        <p class="mt-2 font-mono text-xs text-white/40">
          Credentials are verified against core.users
        </p>
      </div>

      <form
        method="POST"
        action="/api/auth/login-form"
        class="border border-white/10 bg-white/[0.02] p-6 space-y-5"
      >
        <input type="hidden" name="next" value={safeNext} />

        <div>
          <label for="identifier" class="block font-mono text-xs text-white/50 uppercase mb-2">Username / Email</label>
          <input
            id="identifier"
            name="identifier"
            type="text"
            required
            autocomplete="username"
            placeholder="operator"
            class="w-full border border-white/10 bg-black/60 px-4 py-2.5 font-mono text-sm text-white placeholder:text-white/20 focus:border-white/40 focus:outline-none"
          />
        </div>

        <div>
          <label for="password" class="block font-mono text-xs text-white/50 uppercase mb-2">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            placeholder="••••••••"
            class="w-full border border-white/10 bg-black/60 px-4 py-2.5 font-mono text-sm text-white placeholder:text-white/20 focus:border-white/40 focus:outline-none"
          />
        </div>

        {
          error && (
            <p class="font-mono text-xs text-red-400" role="alert">
              {error}
            </p>
          )
        }

        <button
          type="submit"
          class="w-full border border-white/20 bg-white py-2.5 font-mono text-xs tracking-widest font-semibold text-black uppercase hover:bg-white/90 cursor-pointer transition-all"
        >
          Authenticate
        </button>
      </form>

      <p class="text-center font-mono text-[0.62rem] tracking-widest text-white/25 uppercase">
        Unauthorized access attempts are logged
      </p>
    </div>
  </div>
</Layout>
