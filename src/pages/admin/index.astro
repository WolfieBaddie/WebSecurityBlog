---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { Icon } from 'astro-icon/components'
import ContentToolbar  from '@/components/ui/content-toolbar.astro'
---

<Layout variant="immersive">
  <PageHead
    slot="head"
    title="Admin Console"
    description="Operator portal for managing security posts, CTF challenges, and assets."
  />

  <div x-data="adminDashboard()" x-init="init()" class="min-h-screen">
    <!-- Top Hero / Metrics -->
    <section class="relative overflow-hidden border-b border-white/10 bg-black/30">
      <div class="mx-auto max-w-[1400px] px-4 py-12 sm:px-6 lg:px-8">
        <Breadcrumbs
          variant="immersive"
          items={[
            { label: 'Admin', href: '/admin', icon: 'lucide:shield' },
            { label: 'Overview', icon: 'lucide:gauge' },
          ]}
        />

        <div class="mt-8 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
          <div class="max-w-2xl">
            <p class="font-mono text-[0.68rem] tracking-[0.28em] text-white/40 uppercase">
              Operator Console // Control Plane
            </p>
            <h1 class="mt-3 text-3xl font-medium tracking-tight text-white sm:text-4xl">
              Write-ups & Security Labs
            </h1>
            <p class="mt-2 text-base text-white/60">
              Manage markdown notes, structured block payloads, CTF flags, and uploaded visual assets.
            </p>
          </div>

          <a
            href="/admin/posts/new"
            class="inline-flex items-center gap-2 border border-white/20 bg-white px-5 py-2.5 font-mono text-xs font-semibold tracking-widest text-black uppercase hover:bg-white/90 transition-all cursor-pointer"
          >
            <Icon name="lucide:plus" class="size-4" />
            <span>Create Note</span>
          </a>
        </div>

        <aside class="mt-10 self-start">
          <p class="font-mono text-[0.68rem] tracking-[0.24em] text-white/40 uppercase">
            Cluster Snapshot
          </p>
          <div class="mt-4 grid grid-cols-2 gap-px border border-white/10 bg-white/[0.03] sm:grid-cols-4">
            <div class="p-5">
              <p class="text-3xl font-semibold tracking-tighter text-white" x-text="stats.total">00</p>
              <p class="mt-2 font-mono text-[0.66rem] tracking-[0.24em] text-white/40 uppercase">Total Notes</p>
            </div>
            <div class="border-l border-white/10 p-5">
              <p class="text-3xl font-semibold tracking-tighter text-emerald-400" x-text="stats.published">00</p>
              <p class="mt-2 font-mono text-[0.66rem] tracking-[0.24em] text-white/40 uppercase">Published</p>
            </div>
            <div class="border-l border-white/10 p-5">
              <p class="text-3xl font-semibold tracking-tighter text-amber-400" x-text="stats.drafts">00</p>
              <p class="mt-2 font-mono text-[0.66rem] tracking-[0.24em] text-white/40 uppercase">Drafts</p>
            </div>
            <div class="border-l border-white/10 p-5">
              <p class="text-3xl font-semibold tracking-tighter text-white/40" x-text="stats.archived">00</p>
              <p class="mt-2 font-mono text-[0.66rem] tracking-[0.24em] text-white/40 uppercase">Archived</p>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- Table of Posts -->
    <section class="border-b border-white/10">
      <div class="mx-auto max-w-[1400px] px-4 py-12 sm:px-6 lg:px-8">
        <!-- Filter Tabs -->
        <ContentToolbar
          variant="admin"
          filterModel="filter"
          filters={[
            { id: 'all', label: 'All Notes', countKey: 'stats.total' },
            { id: 'published', label: 'Published', countKey: 'stats.published' },
            { id: 'draft', label: 'Drafts', countKey: 'stats.drafts' },
            { id: 'archived', label: 'Archived', countKey: 'stats.archived' },
          ]}
        >
          <a
            slot="actions"
            href="/admin/posts/new"
            class="inline-flex items-center gap-1.5 border border-white/20 bg-white px-3 py-1.5 font-mono text-xs font-semibold text-black uppercase hover:bg-white/90"
          >
            <Icon name="lucide:plus" class="size-3" />
            New
          </a>
        </ContentToolbar>
        <!-- Posts List -->
        <div class="mt-6 divide-y divide-white/10">
          <template x-for="post in filteredPosts" :key="post.id">
            <div class="group flex flex-col justify-between gap-4 py-6 sm:flex-row sm:items-center">
              <div class="space-y-2">
                <div class="flex items-center gap-3">
                  <span
                    class="font-mono text-[0.66rem] uppercase tracking-wider px-2 py-0.5 border"
                    :class="getStatusBadgeClass(post.status)"
                    x-text="post.status"
                  ></span>
                  <span class="font-mono text-xs text-white/40" x-text="post.contentType"></span>
                  <span class="font-mono text-xs text-white/30" x-text="`/${post.slug}`"></span>
                </div>
                <h2 class="text-xl font-medium tracking-tight text-white group-hover:text-white/90">
                  <a :href="`/admin/posts/${post.id}`" x-text="post.title"></a>
                </h2>
                <p class="max-w-2xl text-sm text-white/50" x-text="post.summary || 'No summary provided.'"></p>
              </div>

              <!-- Action Controls -->
              <div class="flex items-center gap-4 self-start font-mono text-xs sm:self-center">
                <a
                  :href="`/admin/posts/${post.id}`"
                  class="border border-white/10 bg-white/[0.04] px-3 py-1.5 text-white/80 hover:border-white/30 hover:text-white transition-colors"
                >
                  Edit Note
                </a>
                <a
                  x-show="post.status === 'published'"
                  :href="`/blog/${post.slug}`"
                  target="_blank"
                  class="text-white/40 hover:text-white transition-colors"
                >
                  View &#8599;
                </a>
                <button
                  type="button"
                  @click="deletePost(post.id)"
                  class="text-red-400/60 hover:text-red-400 transition-colors cursor-pointer"
                >
                  Delete
                </button>
              </div>
            </div>
          </template>

          <div
            x-show="filteredPosts.length === 0"
            class="py-16 text-center font-mono text-xs tracking-widest text-white/30 uppercase"
          >
            No entries found in this view.
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  function adminDashboard() {
    return {
      posts: [],
      filter: 'all',
      stats: { total: 0, published: 0, drafts: 0, archived: 0 },

      async init() {
        await this.loadPosts();
      },

      async loadPosts() {
        try {
          const res = await fetch('/api/posts/admin');
          const json = await res.json();
          if (json.success) {
            this.posts = json.data || [];
            this.computeStats();
          }
        } catch (e) {
          console.error('Failed to load posts', e);
        }
      },

      computeStats() {
        this.stats.total = this.posts.length;
        this.stats.published = this.posts.filter((p) => p.status === 'published').length;
        this.stats.drafts = this.posts.filter((p) => p.status === 'draft').length;
        this.stats.archived = this.posts.filter((p) => p.status === 'archived').length;
      },

      get filteredPosts() {
        if (this.filter === 'all') return this.posts;
        return this.posts.filter((p) => p.status === this.filter);
      },

      getFilterClass(tab) {
        return this.filter === tab
          ? 'text-white border-b-2 border-white'
          : 'text-white/40 hover:text-white';
      },

      getStatusBadgeClass(status) {
        if (status === 'published') return 'border-emerald-500/30 bg-emerald-500/10 text-emerald-400';
        if (status === 'draft') return 'border-amber-500/30 bg-amber-500/10 text-amber-400';
        return 'border-white/20 bg-white/5 text-white/40';
      },

      async deletePost(id) {
        if (!confirm('Permanently delete this post and its content blocks?')) return;
        try {
          const res = await fetch(`/api/posts/${id}`, { method: 'DELETE' });
          if (res.ok) {
            this.posts = this.posts.filter((p) => p.id !== id);
            this.computeStats();
          }
        } catch (err) {
          alert('Failed to delete post');
        }
      },
    };
  }
</script>