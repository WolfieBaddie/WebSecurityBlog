---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import Link from '@/components/link.astro'
import Layout from '@/layouts/layout.astro'
import { LANDING, PROFILE } from '@/consts'

const sections = [
  {
    number: '01',
    title: 'Mission',
    body: 'Break it in the lab. Understand the mechanism. Write the detection. Publish the proof. This site exists to make the full kill chain legible: recon, exploitation, escalation, and the defenses that catch each step.',
  },
  {
    number: '02',
    title: 'What you will find here',
    body: 'Technical articles, CTF and lab write-ups with reproducible payloads, cheatsheets, and challenge content. Everything is authored to be reproducible — every claim is backed by code, command output, or a lab walkthrough you can run yourself.',
  },
  {
    number: '03',
    title: 'Editorial standards',
    body: 'Evidence sits next to the claim. Payloads are documented with prerequisites, verification, and failure modes. Every offensive technique is paired with its detection or hardening counterpart, because understanding a vulnerability means knowing how it is caught.',
  },
  {
    number: '04',
    title: 'Responsible disclosure',
    body: 'This is an educational publication. Techniques are presented for practice in isolated labs you own or are explicitly authorized to test. Vulnerabilities found in third-party systems follow coordinated disclosure: reported privately, fixed, then published. The contact below is the disclosure channel.',
  },
]

const emailLink =
  PROFILE.links.find((item) => item.label === 'Email')?.href ?? 'mailto:contact@yourdomain.com'
const githubLink = PROFILE.links.find((item) => item.label === 'GitHub')?.href
---

<Layout variant="immersive">
  <PageHead
    slot="head"
    title="About"
    description="About the operator and editorial standards behind YxngEcstasy // Security Lab."
  />

  <section class="relative overflow-hidden border-b border-white/10 bg-black/30">
    <div
      class="landing-dot-mass absolute top-0 right-[-6rem] h-[20rem] w-[20rem] opacity-[0.22] sm:right-[-4rem] sm:h-[28rem] sm:w-[28rem] lg:h-[34rem] lg:w-[34rem]"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-white/[0.06] via-transparent to-transparent"
    >
    </div>
    <div class="mx-auto max-w-[1400px] px-4 py-12 sm:px-6 sm:py-14 lg:px-8 lg:py-20">
      <Breadcrumbs
        variant="immersive"
        items={[{ label: 'About', href: '/about', icon: 'lucide:info' }]}
      />

      <div class="mt-8 grid gap-10 xl:grid-cols-[minmax(0,1.08fr)_minmax(300px,0.92fr)] xl:items-start">
        <div class="immersive-animate-in max-w-3xl" transition:name="page-intro">
          <p class="landing-section-label">About // The operator</p>
          <h1 class="mt-4 text-[clamp(2.6rem,5vw,4.4rem)] leading-[0.94] font-semibold tracking-[-0.06em] text-white">
            {LANDING.name} // Security Lab
          </h1>
          <p class="mt-6 max-w-xl text-base leading-7 text-white/60 sm:text-lg sm:leading-8">
            {PROFILE.summary}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <Link href={emailLink} external class="landing-button landing-button--ghost group">
              <span>Responsible disclosure</span>
            </Link>
            {
              githubLink && (
                <Link href={githubLink} external class="landing-button landing-button--ghost group">
                  <span>GitHub</span>
                </Link>
              )
            }
          </div>
        </div>

        <aside class="immersive-panel immersive-animate-in self-start">
          <p class="immersive-eyebrow">Operator facts</p>
          <div class="mt-6 space-y-4">
            {
              PROFILE.facts.map((fact) => (
                <div class="space-y-1 border-b border-white/10 pb-3 last:border-b-0 last:pb-0">
                  <p class="font-mono text-[0.62rem] tracking-[0.24em] text-white/30 uppercase">
                    {fact.label}
                  </p>
                  <p class="text-sm text-white/75">{fact.value}</p>
                </div>
              ))
            }
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="border-b border-white/10">
    <div class="mx-auto max-w-[1400px] px-4 py-12 sm:px-6 sm:py-14 lg:px-8 lg:py-16">
      <p class="landing-section-label">Standards & scope</p>
      <div class="mt-8 grid gap-px border border-white/10 bg-white/[0.03] sm:grid-cols-2">
        {
          sections.map((section) => (
            <article class="bg-black/40 p-6 sm:p-8">
              <p class="font-mono text-[0.62rem] tracking-[0.28em] text-white/30 uppercase">
                {section.number} //
              </p>
              <h2 class="mt-3 text-xl font-medium tracking-[-0.03em] text-white">
                {section.title}
              </h2>
              <p class="mt-3 text-sm leading-7 text-white/55">{section.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-white/10">
    <div class="mx-auto max-w-[1400px] px-4 py-12 sm:px-6 sm:py-14 lg:px-8 lg:py-16">
      <div class="grid gap-10 xl:grid-cols-[minmax(0,1.08fr)_minmax(300px,0.92fr)] xl:items-start">
        <div class="max-w-2xl">
          <p class="landing-section-label">Skills & tooling</p>
          <h2 class="landing-section-title mt-4">What powers the labs.</h2>
          <div class="mt-8 space-y-6">
            {
              PROFILE.skills.map((skill) => (
                <div class="space-y-2">
                  <p class="font-mono text-[0.66rem] tracking-[0.24em] text-white/40 uppercase">
                    {skill.label}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {skill.items.map((item) => (
                      <span class="immersive-chip">{item}</span>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <aside class="immersive-panel self-start">
          <p class="immersive-eyebrow">Contact & disclosure</p>
          <p class="mt-4 text-sm leading-6 text-white/55">
            Found a flaw in a system you operate, or want to collaborate on a lab?
            Email is the disclosure channel. Reports are handled privately until a fix
            ships, then credited in the write-up.
          </p>
          <Link
            href={emailLink}
            external
            class="mt-5 inline-flex max-w-full items-center rounded-full border border-white/12 bg-white/[0.04] px-4 py-2 font-mono text-xs tracking-[0.18em] text-white/80 uppercase transition-all hover:border-white/18 hover:bg-white/[0.06] hover:text-white"
          >
            <span class="truncate" set:html={emailLink.replace('mailto:', '')} />
          </Link>
        </aside>
      </div>
    </div>
  </section>
</Layout>