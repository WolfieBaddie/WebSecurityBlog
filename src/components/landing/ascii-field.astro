---
import { cn } from '@/lib/utils'

interface Props {
  class?: string
  variant?: 'hero' | 'ambient' | 'panel'
}

const { class: className, variant = 'hero' } = Astro.props
---

<div
  data-ascii-variant={variant}
  class={cn('pointer-events-none absolute inset-0 overflow-hidden', className)}
  aria-hidden="true"
>
  <canvas class="h-full w-full opacity-80"></canvas>
</div>

<script is:inline data-astro-rerun>
  ;(() => {
    const script = document.currentScript
    const root = script?.previousElementSibling

    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    if (isMobile) {
      // Do not run the animation loop on phones/tablets
      return;
    }

    if (!(root instanceof HTMLDivElement)) return

    const canvas = root.querySelector('canvas')
    if (!(canvas instanceof HTMLCanvasElement)) return

    const ctx = canvas.getContext('2d', { alpha: true })
    if (!ctx) return

    const variant = root.dataset.asciiVariant || 'hero'
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
    const config = {
      hero: {
        glyphs: ['.', ':', '+', '*', '#', 'x', '='],
        cellMin: 18, // slightly larger cell = 40% fewer glyphs
        cellMax: 26,
        alpha: 0.92,
        speed: 1,
        interactive: true,
        fontScale: 0.62,
        compactGlyphScale: 0.52,
        compactGlyphs: ['+', '*', '#', 'x', '='],
      },
      ambient: {
        glyphs: ['.', ':', '+', 'x'],
        cellMin: 22,
        cellMax: 32,
        alpha: 0.55,
        speed: 0.52,
        interactive: false,
        fontScale: 0.68,
        compactGlyphScale: 0.68,
        compactGlyphs: [],
      },
      panel: {
        glyphs: ['.', ':', '=', 'x'],
        cellMin: 20,
        cellMax: 28,
        alpha: 0.72,
        speed: 0.7,
        interactive: false,
        fontScale: 0.68,
        compactGlyphScale: 0.68,
        compactGlyphs: [],
      },
    }[variant]
    const compactGlyphs = new Set(config.compactGlyphs)
    const pointer = { x: 0.78, y: 0.32 }

    let frameId = 0
    let rafActive = true
    let isVisible = true
    let lastDrawTime = 0
    const TARGET_FPS_INTERVAL = 1000 / 30 // Lock to 30 FPS for silky, lightweight rendering

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5) // Cap DPR at 1.5 instead of 2+
      const { width, height } = root.getBoundingClientRect()

      canvas.width = Math.max(1, Math.floor(width * dpr))
      canvas.height = Math.max(1, Math.floor(height * dpr))
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    }

    const draw = (time = 0) => {
      if (!rafActive || !isVisible) return

      // FPS Throttling: Skip frames if under 30ms interval
      const elapsed = time - lastDrawTime
      if (elapsed < TARGET_FPS_INTERVAL) {
        frameId = window.requestAnimationFrame(draw)
        return
      }
      lastDrawTime = time - (elapsed % TARGET_FPS_INTERVAL)

      const width = canvas.clientWidth
      const height = canvas.clientHeight
      const reducedMotion = motionQuery.matches
      const seconds = time * 0.001 * config.speed
      const cell = Math.max(
        config.cellMin,
        Math.min(config.cellMax, Math.round(width / 70)),
      )

      ctx.clearRect(0, 0, width, height)
      ctx.textBaseline = 'middle'
      ctx.textAlign = 'center'

      const compactFont = `${cell * config.compactGlyphScale}px "Geist Mono", monospace`
      const normalFont = `${cell * config.fontScale}px "Geist Mono", monospace`
      let currentFont = ''

      for (let y = cell * 0.7; y < height; y += cell) {
        for (let x = cell * 0.7; x < width; x += cell) {
          const nx = x / width - 0.5
          const ny = y / height - 0.5
          const radius = Math.hypot(nx * 1.25, ny * 1.1)
          const fade = Math.max(0, 1 - radius * 1.55)
          const wave =
            Math.sin(nx * 11 + seconds * 0.9) * 0.18 +
            Math.cos(ny * 15 - seconds * 0.8) * 0.18
          const dx = x / width - pointer.x
          const dy = y / height - pointer.y
          const pointerField = config.interactive
            ? Math.max(0, 0.42 - Math.hypot(dx, dy)) * 1.85
            : 0
          const intensity = fade * 0.72 + pointerField + wave

          if (intensity < 0.14) continue

          const glyphIndex = Math.min(
            config.glyphs.length - 1,
            Math.max(0, Math.floor(intensity * config.glyphs.length)),
          )
          const glyph = config.glyphs[glyphIndex]
          const alpha = Math.min(config.alpha, 0.08 + intensity * 0.72)

          const nextFont = compactGlyphs.has(glyph) ? compactFont : normalFont
          if (nextFont !== currentFont) {
            ctx.font = nextFont
            currentFont = nextFont
          }

          ctx.fillStyle = `rgba(248, 248, 248, ${alpha})`
          ctx.fillText(glyph, x, y)
        }
      }

      if (!reducedMotion && rafActive) {
        frameId = window.requestAnimationFrame(draw)
      }
    }

    const handlePointer = (event) => {
      pointer.x = event.clientX / window.innerWidth
      pointer.y = event.clientY / window.innerHeight
    }

    // Freeze animation completely when scrolled out of view or tab hidden
    const observer = new IntersectionObserver(
      ([entry]) => {
        isVisible = entry.isIntersecting
        if (isVisible && rafActive && !motionQuery.matches) {
          window.cancelAnimationFrame(frameId)
          frameId = window.requestAnimationFrame(draw)
        }
      },
      { threshold: 0.05 }
    )
    observer.observe(canvas)

    const cleanup = () => {
      rafActive = false
      observer.disconnect()
      window.cancelAnimationFrame(frameId)
      window.removeEventListener('resize', resize)
      window.removeEventListener('pointermove', handlePointer)
    }

    resize()
    draw()

    if (!motionQuery.matches) {
      frameId = window.requestAnimationFrame(draw)
    }

    window.addEventListener('resize', resize, { passive: true })
    if (config.interactive) {
      window.addEventListener('pointermove', handlePointer, { passive: true })
    }
    document.addEventListener('astro:before-swap', cleanup, { once: true })
    window.addEventListener('pagehide', cleanup, { once: true })
  })()
</script>