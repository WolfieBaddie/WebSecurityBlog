---
import { Icon } from 'astro-icon/components'

export interface DropdownOption {
  value: string | number | null
  label: string
  description?: string
}

interface Props {
  /** Accessible label shown above the trigger */
  label?: string
  /** Alpine property path to bind, e.g. "form.categoryId" or "filter" */
  model: string
  /** Static options, rendered server-side (use when the list is known at build time) */
  options?: DropdownOption[]
  /** Name of a runtime Alpine array in scope (use when options load from an API) */
  optionsRef?: string
  placeholder?: string
  /** Prepends a null-value option (e.g. "— No category —") */
  nullable?: boolean
  nullableLabel?: string
  /** Optional hint rendered under the trigger */
  hint?: string
  class?: string
}

const {
  label,
  model,
  options = [],
  optionsRef,
  placeholder = 'Select...',
  nullable = false,
  nullableLabel = 'None',
  hint,
  class: className = '',
} = Astro.props

// Runtime mode: options live in an Alpine array resolved at walk-time
const isRuntime = Boolean(optionsRef)

// Static mode: server-render the selection expressions.
// JSON.stringify preserves types (numbers stay numbers, null stays null).
const allOptions: DropdownOption[] = nullable
  ? [{ value: null, label: nullableLabel }, ...options]
  : options

const isSelectedExpr = (v: any) => `(${model} === ${JSON.stringify(v)})`
const staticLabelExpr =
  allOptions.map((o) => `${isSelectedExpr(o.value)} ? ${JSON.stringify(o.label)}`).join(' : ') +
  ` : ${JSON.stringify(placeholder)}`

// Runtime label: find the matching option, fall back to placeholder
const runtimeLabelExpr = optionsRef
  ? `(${optionsRef}.find(o => o.value === ${model}) ?? { label: ${JSON.stringify(nullable ? nullableLabel : placeholder)} }).label`
  : ''

const activeClasses =
  'bg-white/[0.08] text-white border-white/20'
const idleClasses =
  'text-white/55 hover:text-white hover:bg-white/[0.04] border-transparent'
---

<div class={`relative ${className}`} x-data="{ open: false }" @click.outside="open = false" @keydown.escape="open = false">
  {
    label && (
      <label class="mb-2 block font-mono text-[0.66rem] tracking-[0.24em] text-white/40 uppercase">
        {label}
      </label>
    )
  }

  <!-- Trigger -->
  <button
    type="button"
    @click="open = !open"
    :class={`open ? 'border-white/30 bg-white/[0.05]' : 'border-white/10 bg-black/60 hover:border-white/20'`}
    class="flex w-full items-center justify-between gap-3 border px-4 py-2.5 text-left transition-colors cursor-pointer focus:outline-none focus:border-white/40"
    aria-haspopup="listbox"
  >
    {
      isRuntime ? (
        <span class="truncate font-mono text-sm text-white" x-text={runtimeLabelExpr}>
          {placeholder}
        </span>
      ) : (
        <span class="truncate font-mono text-sm text-white" x-text={staticLabelExpr}>
          {placeholder}
        </span>
      )
    }
    <Icon
      name="lucide:chevron-down"
      class="size-4 shrink-0 text-white/40 transition-transform duration-200"
      :class={`open ? 'rotate-180 text-white/70' : ''`}
    />
  </button>

  <!-- Options panel -->
  {
    isRuntime ? (
      <div
        x-show="open"
        x-transition.opacity.duration.150ms
        class="absolute z-50 mt-1 max-h-60 w-full overflow-y-auto border border-white/10 bg-[#050505] shadow-[0_8px_30px_rgba(0,0,0,0.6)]"
        role="listbox"
      >
        <template x-for={`opt in ${optionsRef}`} :key="opt.value">
          <button
            type="button"
            role="option"
            @click={`${model} = opt.value; open = false`}
            :class={`opt.value === ${model} ? '${activeClasses}' : '${idleClasses}'`}
            class="group flex w-full items-center justify-between gap-3 border-b border-white/[0.06] px-4 py-2.5 text-left transition-colors cursor-pointer last:border-b-0"
          >
            <span class="min-w-0">
              <span class="block truncate font-mono text-xs tracking-wider text-inherit uppercase" x-text="opt.label"></span>
              <span
                x-show="opt.description"
                x-text="opt.description"
                class="mt-0.5 block truncate font-mono text-[0.62rem] text-white/30 normal-case"
              ></span>
            </span>
            <Icon
              name="lucide:check"
              class="size-4 shrink-0 text-emerald-400 opacity-0 transition-opacity"
              :class={`opt.value === ${model} ? 'opacity-100' : ''`}
            />
          </button>
        </template>
      </div>
    ) : (
      <div
        x-show="open"
        x-transition.opacity.duration.150ms
        class="absolute z-50 mt-1 max-h-60 w-full overflow-y-auto border border-white/10 bg-[#050505] shadow-[0_8px_30px_rgba(0,0,0,0.6)]"
        role="listbox"
      >
        {allOptions.map((opt) => (
          <button
            type="button"
            role="option"
            @click={`${model} = ${JSON.stringify(opt.value)}; open = false`}
            :class={`${isSelectedExpr(opt.value)} ? '${activeClasses}' : '${idleClasses}'`}
            class="flex w-full items-center justify-between gap-3 border-b border-white/[0.06] px-4 py-2.5 text-left transition-colors cursor-pointer last:border-b-0"
          >
            <span class="truncate font-mono text-xs tracking-wider uppercase">{opt.label}</span>
            <Icon
              name="lucide:check"
              class="size-4 shrink-0 text-emerald-400 opacity-0 transition-opacity"
              :class={`${isSelectedExpr(opt.value)} ? 'opacity-100' : ''`}
            />
          </button>
        ))}
      </div>
    )
  }

  {hint && <p class="mt-1.5 font-mono text-[0.62rem] text-white/30">{hint}</p>}
</div>
